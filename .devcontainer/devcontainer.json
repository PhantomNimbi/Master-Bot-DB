{
  "name": "PostgreSQL Server Infrastructure",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/postgres:1": {
      "version": "16"
    }
  },
  "forwardPorts":,
  "portsAttributes": {
    "5432": {
      "label": "PostgreSQL Port",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "PGUSER": "${localEnv:DB_USER}",
    "PGPASSWORD": "${localEnv:DB_PASSWORD}",
    "PGDATABASE": "${localEnv:DB_NAME}"
  },
  "postCreateCommand": "bash .devcontainer/setup-databases.sh"
}
