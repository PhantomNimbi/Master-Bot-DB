{
  "name": "Master-Bot Prisma DB Infrastructure",
  // Tells Codespaces to look for the compose file in the repository root
  "dockerComposeFile": "../docker-compose.yml",
  // Targets the main database container as the primary shell context
  "service": "db_main",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    5432,
    5433
  ],
  "portsAttributes": {
    "5432": {
      "label": "Master-Bot Core DB Engine",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5433": {
      "label": "Master-Bot Shadow DB Engine",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "DB_USER_SECRET": "${localEnv:DB_USER}",
    "DB_PASSWORD_SECRET": "${localEnv:DB_PASSWORD}",
    "DB_NAME_SECRET": "${localEnv:DB_NAME}"
  }
}
