{
  "name": "Master-Bot Prisma DB Infrastructure",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "db_main",
  "workspaceFolder": "/workspace",
  "forwardPorts":,
  "portsAttributes": {
    "5432": {
      "label": "Master-Bot Core DB Engine",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5433": {
      "label": "Master-Bot Shadow DB Engine",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "6379": {
      "label": "Master-Bot Shared Redis Cache",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "DB_USER": "${localEnv:DB_USER}",
    "DB_PASSWORD": "${localEnv:DB_PASSWORD}",
    "DB_NAME": "${localEnv:DB_NAME}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github"
      ]
    }
  }
}
